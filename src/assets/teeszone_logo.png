<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 450 90" width="450" height="90">
  <defs>
    <linearGradient id="burgundyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7A1E32" />
      <stop offset="50%" stop-color="#5A1424" />
      <stop offset="100%" stop-color="#3D030F" />
    </linearGradient>
  </defs>
  
  <!-- 3D Geometric T Emblem in Deep Burgundy -->
  <g transform="translate(10, 10)">
    <!-- Isometric Left Arm -->
    <path d="M 35,6 L 10,20 L 10,34 L 25,26 L 25,56 L 36,63 L 36,24 L 47,17 Z" fill="#4A0A17" />
    <!-- Isometric Right Arm -->
    <path d="M 35,6 L 60,20 L 60,34 L 45,26 L 45,56 L 34,63 L 34,24 L 23,17 Z" fill="#6E1B2D" />
    <!-- Inner Highlight -->
    <path d="M 35,12 L 50,21 L 40,28 L 40,54 L 35,57 L 30,54 L 30,28 L 20,21 Z" fill="none" stroke="#9A2D45" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" />
    <!-- Top Facet -->
    <path d="M 35,5 L 10,19 L 22,26 L 35,18 L 48,26 L 60,19 Z" fill="#801C31" />
  </g>

  <!-- Typography: TEESZONE in Deep Burgundy -->
  <text x="85" y="48" font-family="'Inter', 'Segoe UI', -apple-system, sans-serif" font-size="44" font-weight="900" letter-spacing="3.5" fill="url(#burgundyGrad)">
    TEESZONE
  </text>
  
  <!-- Tagline: elevate your style with custom tees in Deep Burgundy -->
  <text x="87" y="70" font-family="'Inter', 'Segoe UI', -apple-system, sans-serif" font-size="12" font-weight="800" letter-spacing="2.2" fill="#5A1424">
    elevate your style with custom tees
  </text>
</svg>